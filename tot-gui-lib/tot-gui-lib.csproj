        <PackageReference Include="DynamicData" Version="9.5.0" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.6" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="System.Reactive" Version="7.0.0" />
        <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.7" />
        <PackageReference Include="Humanizer" Version="3.0.10" />
        <PackageReference Include="Optris.Icons.Avalonia.MaterialDesign" Version="12.0.7" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\tot-lib\tot-lib.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="MarkdownHeaderLight.html" />
