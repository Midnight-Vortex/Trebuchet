<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:f="clr-namespace:Trebuchet.ViewModels.SettingFields"
                    xmlns:c="clr-namespace:tot_gui_lib.Controls;assembly=tot-gui-lib"
                    xmlns:a="clr-namespace:Trebuchet.Assets"
                    xmlns:i="https://github.com/projektanker/icons.avalonia"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="RestartWarningsField" DataType="f:RestartWarningsField">
        <Border Classes="Panel Shadowed" Padding="12,12" Margin="0,0,0,12" IsVisible="{Binding IsVisible}">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                <TextBlock IsVisible="{Binding DisplayDescription}" Text="{Binding Description}" Classes="SubText" TextWrapping="Wrap" FontWeight="Normal" />
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="f:RestartWarningViewModel">
                            <DockPanel LastChildFill="True">
                                <c:Duration DockPanel.Dock="Left" DurationValue="{Binding Before}" Width="240" Margin="0,0,6,0" VerticalAlignment="Center"
                                            ToolTip.Tip="{x:Static a:Resources.RestartWarningBeforeTip}" />
                                <Button DockPanel.Dock="Right" Classes="Base Red Colored" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding $parent[ItemsControl].((f:RestartWarningsField)DataContext).Remove}"
                                        CommandParameter="{Binding .}">
                                    <i:Icon Value="mdi-delete" Classes="Normal" />
                                </Button>
                                <TextBox Text="{Binding Message}" VerticalAlignment="Center" PlaceholderText="{x:Static a:Resources.RestartWarningMessagePlaceholder}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                    <Button Classes="Base Flat" Command="{Binding ResetDefaults}">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <i:Icon Value="mdi-restore" Classes="Normal" />
                            <TextBlock Text="{x:Static a:Resources.RestartWarningResetDefaults}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="Base Green" Command="{Binding Add}">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <i:Icon Value="mdi-plus" Classes="Normal" />
                            <TextBlock Text="{x:Static a:Resources.RestartWarningAdd}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
