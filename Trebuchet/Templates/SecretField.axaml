<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="https://github.com/projektanker/icons.avalonia"
                    xmlns:a="clr-namespace:Trebuchet.Assets"
                    xmlns:c="clr-namespace:Trebuchet.Controls"
                    xmlns:settingFields="clr-namespace:Trebuchet.ViewModels.SettingFields">
    <!-- Write-only: shows whether a secret is saved, never the secret. The input box is not bound to the view model. -->
    <DataTemplate x:Key="SecretField" x:DataType="settingFields:SecretField">
        <c:FieldRowControl>
            <c:FieldRowControl.FieldContent>
                <StackPanel Spacing="6" Margin="0,3" MaxWidth="600" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSet}">
                        <i:Icon Value="mdi-check-circle" Classes="Normal" Foreground="{DynamicResource TGreen}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SavedText}" VerticalAlignment="Center" FontWeight="Bold" />
                        <Button Command="{Binding StartReplace}" Classes="Base Blue" Margin="12,0,0,0"
                                IsVisible="{Binding CanReplace}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:Icon Value="mdi-swap-horizontal" Classes="Normal" />
                                <TextBlock Text="{x:Static a:Resources.DiscordBotReplace}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding Remove}" Classes="Base Red" IsVisible="{Binding CanReplace}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:Icon Value="mdi-delete" Classes="Normal" />
                                <TextBlock Text="{x:Static a:Resources.Remove}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasNote}">
                        <i:Icon Value="mdi-information-outline" Classes="Normal" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" />
                    </StackPanel>
                    <DockPanel IsVisible="{Binding IsEditing}" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Command="{Binding CancelReplace}" Classes="Base" Margin="6,0,0,0"
                                VerticalAlignment="Center" IsVisible="{Binding IsSet}">
                            <TextBlock Text="{x:Static a:Resources.Cancel}" />
                        </Button>
                        <c:SecretBox SubmitCommand="{Binding Submit}" Watermark="{Binding Watermark}" MinWidth="380" />
                    </DockPanel>
                    <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="Error" TextWrapping="Wrap" />
                </StackPanel>
            </c:FieldRowControl.FieldContent>
        </c:FieldRowControl>
    </DataTemplate>
</ResourceDictionary>
