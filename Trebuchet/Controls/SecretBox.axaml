<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:a="clr-namespace:Trebuchet.Assets"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="40"
             x:Class="Trebuchet.Controls.SecretBox">
    <DockPanel LastChildFill="True">
        <Button x:Name="SubmitButton" DockPanel.Dock="Right" Classes="Base Green" Margin="6,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <i:Icon Value="mdi-content-save" Classes="Normal" />
                <TextBlock Text="{x:Static a:Resources.Save}" />
            </StackPanel>
        </Button>
        <!-- Masked, no undo history (it would keep copies of the text). Its text is never bound. -->
        <TextBox x:Name="Input"
                 PasswordChar="•"
                 RevealPassword="False"
                 IsUndoEnabled="False"
                 AcceptsReturn="False"
                 MaxLength="200"
                 Height="25"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center" />
    </DockPanel>
</UserControl>
