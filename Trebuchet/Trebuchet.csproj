<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <Authors>Totchinuko</Authors>
        <!-- Reproducible: VERSION file only (e.g. 0.9.0). Optional revision via /p:VersionSuffix=... -->
        <Version>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)\\..\\VERSION").Trim())$(VersionSuffix)</Version>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <Deterministic>true</Deterministic>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

        <Product>trebuchet</Product>
        <Description>Open Source Conan Exile Launcher</Description>
        <Company>totchinuko</Company>
        <Copyright>Copyright © $([System.DateTime]::Now.Year) Totchinuko https://github.com/Totchinuko</Copyright>
        <PackageLicenseExpression>GPL-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Totchinuko/Trebuchet.git</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Totchinuko/Trebuchet.git</RepositoryUrl>
        <RepositoryType>Private</RepositoryType>
        <ApplicationIcon>app.red.ico</ApplicationIcon>
    </PropertyGroup>
    
<!--    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">-->
<!--      <DebugType>none</DebugType>-->
<!--    </PropertyGroup>-->

    <ItemGroup>
        <None Include="maps.json">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <AvaloniaResource Include="app.red.ico" />
        <None Remove="Assets\Hack-Regular.ttf" />
        <AvaloniaResource Include="Assets\Hack-Regular.ttf" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AsyncImageLoader.Avalonia" Version="3.8.0" />
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageReference Include="Avalonia.HtmlRenderer" Version="12.0.0" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.1" />
        <PackageReference Include="System.Reactive" Version="7.0.0" />
        <PackageReference Include="DynamicData" Version="9.4.33" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
        <!-- Avalonia.Diagnostics has no 12.x (deprecated). Always reference so Debug/Release restore stays consistent; attach only in #if DEBUG. -->
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
        <PackageReference Include="Cyotek.CircularBuffer" Version="1.2.1" />
        <PackageReference Include="Humanizer" Version="3.0.10" />
        <PackageReference Include="HyperText.Avalonia" Version="2.0.0" />
        <PackageReference Include="Markdig" Version="1.3.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
        <PackageReference Include="Optris.Icons.Avalonia.MaterialDesign" Version="12.0.7" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SteamWorksWebAPI\SteamWorksWebAPI.csproj" />
        <ProjectReference Include="..\tot-gui-lib\tot-gui-lib.csproj" />
        <ProjectReference Include="..\TrebuchetLib\TrebuchetLib.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Assets\maps.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Assets\Resources.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <None Remove="Assets\LogHightlighting.xshd" />
        <EmbeddedResource Include="Assets\LogHightlighting.xshd" />
    </ItemGroup>
    
    <ItemGroup>
      <Compile Update="Assets\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
