<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:a="clr-namespace:Trebuchet.Assets"
        xmlns:c="clr-namespace:tot_gui_lib.Controls;assembly=tot-gui-lib"
        xmlns:vm="clr-namespace:Trebuchet.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="Trebuchet.Windows.GameBuildWindow"
        x:DataType="vm:GameBuildViewModel"
        Height="400"
        Width="600"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="40"
        UseLayoutRounding="True"
        Classes="Trebuchet"
        Title="{x:Static a:Resources.GameBuild}">
    <Border x:Name="MainBorder">
        <DockPanel LastChildFill="True">
            <c:WindowTitlebar
                DockPanel.Dock="Top"
                Title="{x:Static a:Resources.GameBuild}"
                DisableMaximize="True"
                DisableMinimize="True" />
            <ProgressBar DockPanel.Dock="Bottom"
                         Height="4"
                         Margin="20,0,20,12"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsOpening}" />
            <!-- LastChildFill: keep Legacy / Enhanced / Test Live centered in the content area -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Classes="Base Blue"
                        Height="128"
                        Width="128"
                        IsEnabled="{Binding !IsOpening}"
                        Command="{Binding LiveCommand}">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <i:Icon Value="mdi-controller" HorizontalAlignment="Center" FontSize="40" />
                        <TextBlock FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Grid.Row="2"
                                   Text="{x:Static a:Resources.Legacy}" />
                    </Grid>
                </Button>

                <Button Grid.Column="2"
                        Classes="Base Blue"
                        Height="128"
                        Width="128"
                        IsEnabled="{Binding !IsOpening}"
                        Command="{Binding EnhancedCommand}">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <i:Icon Value="mdi-rocket-launch" HorizontalAlignment="Center" FontSize="40" />
                        <TextBlock FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Grid.Row="2"
                                   Text="{x:Static a:Resources.Enhanced}" />
                    </Grid>
                </Button>

                <Button Grid.Column="4"
                        Classes="Base Blue"
                        Height="128"
                        Width="128"
                        IsEnabled="{Binding !IsOpening}"
                        Command="{Binding TestLiveCommand}">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <i:Icon Value="mdi-test-tube" HorizontalAlignment="Center" FontSize="40" />
                        <TextBlock FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Grid.Row="2"
                                   Text="{x:Static a:Resources.TestLive}" />
                    </Grid>
                </Button>
            </Grid>
        </DockPanel>
    </Border>
    
</Window>
